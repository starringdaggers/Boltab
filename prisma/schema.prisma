// Boltab Brilliant Schools — Results Portal
// Database schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Login rate limiting: 3 failed attempts locks the account for 10 minutes
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  student Student?
  teacher Teacher?

  timetablesCreated Timetable[]
  reviewedFeePayments FeePayment[]

  @@map("users")
}

// A flexible grid-based timetable or roster, built freely by admin with
// any number of rows/columns. Read-only for teachers and students.
model Timetable {
  id      String @id @default(cuid())
  title   String // e.g. "Boltab-Basic 6 — Weekly Timetable" or "Staff Duty Roster"
  columns Json   // array of column header strings
  rows    Json   // array of rows, each an array of cell strings (same length as columns)

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("timetables")
}

model Student {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  admissionNo   String   @unique
  classId       String
  class         Class    @relation(fields: [classId], references: [id])
  guardianName  String?
  guardianPhone String?

  results     Result[]
  reportCards ReportCard[]
  feePayments FeePayment[]
  attendanceRecords AttendanceRecord[]

  @@map("students")
}

model Teacher {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Subjects/classes this teacher is permitted to enter results for
  assignments TeacherAssignment[]
  resultsUploaded Result[]
  reportCardsUpdated ReportCard[]
  attendanceMarked AttendanceRecord[]

  @@map("teachers")
}

model TeacherAssignment {
  id        String  @id @default(cuid())
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  classId   String
  class     Class   @relation(fields: [classId], references: [id])
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  @@unique([teacherId, classId, subjectId])
  @@map("teacher_assignments")
}

model Class {
  id   String @id @default(cuid())
  name String @unique // e.g. "JSS1", "SS2 Science"

  students    Student[]
  assignments TeacherAssignment[]
  results     Result[]
  classFees   ClassFee[]
  attendanceRecords AttendanceRecord[]

  @@map("classes")
}

model Subject {
  id   String @id @default(cuid())
  name String @unique // e.g. "Mathematics", "English Language"

  assignments TeacherAssignment[]
  results     Result[]

  @@map("subjects")
}

model Term {
  id          String   @id @default(cuid())
  name        String   // e.g. "First Term"
  academicYear String  // e.g. "2026/2027"
  isLocked    Boolean  @default(false) // admin can lock a term to stop further edits
  resultsReleased Boolean @default(false) // admin controls whether students can see results/report cards for this term at all

  results     Result[]
  reportCards ReportCard[]
  classFees   ClassFee[]
  feePayments FeePayment[]
  attendanceRecords AttendanceRecord[]

  @@unique([name, academicYear])
  @@map("terms")
}

model Result {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId    String
  class      Class    @relation(fields: [classId], references: [id])
  subjectId  String
  subject    Subject  @relation(fields: [subjectId], references: [id])
  termId     String
  term       Term     @relation(fields: [termId], references: [id])

  // Continuous-assessment breakdown, mirroring the school's paper report card
  firstHalfScore       Float  @default(0)
  firstHalfObtainable  Float  @default(20)
  secondHalfScore      Float  @default(0)
  secondHalfObtainable Float  @default(20)
  examScore            Float  @default(0)
  examObtainable       Float  @default(60)

  totalScore      Float    // computed at write time: sum of the three scores above
  totalObtainable Float    @default(100)
  grade           String   // word rating computed from percentage, e.g. "Excellent", "Good"
  remark          String?  // optional teacher override/comment for this subject

  uploadedById String
  uploadedBy   Teacher @relation(fields: [uploadedById], references: [id])
  uploadedAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([studentId, subjectId, termId]) // one result per student/subject/term
  @@map("results")
}

// One record per student per term — the non-subject parts of the paper
// report card: attendance, psychomotor/affective ratings, and comments.
model ReportCard {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  termId    String
  term      Term    @relation(fields: [termId], references: [id])

  // 1. Attendance
  timesSchoolOpened Int?
  timesPresent      Int?
  timesAbsent       Int?
  nextTermBegins    String?

  // 3 & 4. Psychomotor skills / affective areas — each stored as
  // { "Verbal Fluency": 5, "Games": 4, ... } with ratings 1-5
  psychomotor Json?
  affective   Json?

  generalPerformance  String?
  classTeacherName    String?
  classTeacherComment String?
  headmasterComment   String?
  dateIssued          String?

  // 5. Weight & Height
  weightKg Float?
  heightCm Float?

  // Admin-controlled: hides this specific student's report card/results even
  // when the term overall has been released to students.
  isWithheld Boolean @default(false)

  // Set when the class teacher clicks "Mark as complete" after filling in
  // attendance/psychomotor/affective/weight/height. Subject scores and the
  // overall percentage are always computed live from Result rows — this
  // flag just tracks whether the teacher has finished reviewing everything.
  isComplete  Boolean   @default(false)
  completedAt DateTime?

  updatedById String?
  updatedBy   Teacher? @relation(fields: [updatedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([studentId, termId])
  @@map("report_cards")
}

// Bank account details shown to students for making fee transfers.
// Admin can list more than one (e.g. different banks).
model SchoolAccount {
  id            String   @id @default(cuid())
  bankName      String
  accountName   String
  accountNumber String
  notes         String? // e.g. "Use your ward's admission number as reference"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("school_accounts")
}

// The fee amount admin sets for a given class, per term.
model ClassFee {
  id      String @id @default(cuid())
  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  termId  String
  term    Term   @relation(fields: [termId], references: [id], onDelete: Cascade)
  amount  Float // total fee for this class this term, in Naira — sum of lineItems when present

  // Itemized breakdown matching the physical bill (e.g. School fees,
  // Examination, Development), stored as [{ "label": "...", "amount": 0 }].
  // Null/empty means this bill predates itemization and just uses `amount`.
  lineItems Json?

  // Admin can build/edit a bill privately, then release it to students
  // whenever they're ready — students never see a bill before release.
  isReleased Boolean   @default(false)
  releasedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classId, termId])
  @@map("class_fees")
}

// A student's fee payment claim — full or partial. Stays PENDING until an
// admin checks the receipt and approves or rejects it; only APPROVED
// payments count toward the student's paid total/remaining balance.
model FeePayment {
  id       String  @id @default(cuid())
  studentId String
  student  Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  termId   String
  term     Term    @relation(fields: [termId], references: [id], onDelete: Cascade)

  amountClaimed Float // what the student says they paid
  // Receipt stored inline as a base64 data URL — no external file storage
  // configured for this app yet, so keep uploads small (enforced client-side).
  receiptDataUrl  String
  receiptFileName String

  status     String    @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED"
  adminNote  String?
  reviewedById String?
  reviewedBy   User?   @relation(fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  submittedAt DateTime @default(now())

  @@map("fee_payments")
}

model AttendanceRecord {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  termId    String
  term      Term     @relation(fields: [termId], references: [id], onDelete: Cascade)
  date      DateTime // stored at midnight UTC for the day being marked

  status String // "PRESENT" | "ABSENT" | "LATE"

  markedById String
  markedBy   Teacher @relation(fields: [markedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, date])
  @@map("attendance_records")
}
